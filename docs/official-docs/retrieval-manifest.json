{
  "schemaVersion": 1,
  "description": "Machine-readable retrieval and repository-tool registry. The Markdown context router is the human-readable companion.",
  "tools": [
    {
      "id": "route",
      "command": "npm run repo -- route <task-or-error>",
      "purpose": "Rank the smallest relevant documentation sections, source symbols, tools, and verification commands.",
      "mode": "read-only",
      "script": "scripts/repo-tool.js"
    },
    {
      "id": "docs-check",
      "command": "npm run docs:check",
      "purpose": "Validate documentation contracts, links, plan states, retrieval entries, tool registration, and numeric source ranges.",
      "mode": "read-only",
      "script": "scripts/check-docs.js"
    },
    {
      "id": "verify-phase1",
      "command": "npm run repo -- verify phase1",
      "purpose": "Verify Electron authentication, secret isolation, and legacy transport contracts.",
      "mode": "read-only",
      "script": "scripts/verify-phase1.js"
    },
    {
      "id": "verify-phase2",
      "command": "npm run repo -- verify phase2",
      "purpose": "Verify Shopify/D1/R2 candidate, board, asset, migration, batching, and conflict contracts.",
      "mode": "read-only",
      "script": "scripts/verify-phase2.js"
    },
    {
      "id": "redis-backup",
      "command": "npm run repo -- redis backup",
      "purpose": "Read the legacy Redis queue and write a checksummed backup plus redacted fixtures under ignored backups/.",
      "mode": "local-write",
      "script": "scripts/backup-redis-queue.js"
    },
    {
      "id": "migration",
      "command": "npm run repo -- migration dry-run --shop <domain> --env <environment> --url <worker-url>",
      "purpose": "Run bounded authenticated migration pages. Dry-run is the default; execution requires --execute and an exact --confirm-shop.",
      "mode": "remote-read-by-default",
      "script": "scripts/run-shadow-migration.js"
    },
    {
      "id": "completion-repair",
      "command": "npm run repo -- completion dry-run --shop <domain> --env <environment> --url <worker-url>",
      "purpose": "Report active print-stage orders already at 100% and, only with explicit execute confirmation, repair their canonical stage to completed.",
      "mode": "remote-read-by-default",
      "script": "scripts/repair-production-completion.js"
    },
    {
      "id": "parity",
      "command": "npm run repo -- parity check",
      "purpose": "Run the authenticated, PII-redacted server-side legacy/candidate parity comparison.",
      "mode": "remote-read-only",
      "script": "scripts/run-parity-check.js"
    },
    {
      "id": "desktop-config",
      "command": "npm run repo -- build desktop-config",
      "purpose": "Generate ignored non-secret Electron runtime configuration before packaging.",
      "mode": "local-write",
      "script": "scripts/create-desktop-config.js"
    },
    {
      "id": "cloudflare-bundle",
      "command": "npm run repo -- build cloudflare",
      "purpose": "Prepare the Cloudflare Pages upload bundle.",
      "mode": "local-write",
      "script": "scripts/prepare-cloudflare-pages-upload.sh"
    },
    {
      "id": "cloudflare-deploy",
      "command": "npm run repo -- deploy cloudflare -- --production|--preview [branch]",
      "purpose": "Publish a prepared Cloudflare Pages release and verify its served release marker.",
      "mode": "remote-write",
      "script": "scripts/deploy-cloudflare-pages.sh"
    }
  ],
  "routes": [
