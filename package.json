{
  "name": "printmo-order-management",
  "version": "1.3.0",
  "description": "Desktop app for managing PrintMO orders and batching to S&S Activewear",
  "author": "Ethan Duke ethan.duke@icloud.com",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/create-desktop-config.js",
    "dist": "electron-builder",
    "prepare:cloudflare": "bash scripts/prepare-cloudflare-pages-upload.sh",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare-pages.sh",
    "repo": "node scripts/repo-tool.js",
    "docs:check": "node scripts/check-docs.js",
    "verify:phase1": "node scripts/verify-phase1.js",
    "verify:phase2": "node scripts/verify-phase2.js"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^26.0.12",
    "redis": "^4.7.0"
  },
  "build": {
    "appId": "com.printmo.orders",
    "productName": "PrintMO Order Management",
    "directories": {
      "output": "dist",
      "buildResources": "Assets"
    },
    "extraResources": [
      {
        "from": ".build/app-config.json",
        "to": "app-config.json",
        "filter": ["**/*"]
      },
      {
        "from": "Assets/ApparelCount.svg",
        "to": "Assets/ApparelCount.svg"
      },
      {
        "from": "Assets/PrintCount.svg",
        "to": "Assets/PrintCount.svg"
      },
      {
        "from": "Assets/ApparelCountGreen.svg",
        "to": "Assets/ApparelCountGreen.svg"
      },
      {
        "from": "Assets/PrintCountGreen.svg",
        "to": "Assets/PrintCountGreen.svg"
      }
    ],
    "files": [
      "**/*",
      "!.env",
      "!backups/**",
      "!.build/**"
    ],
    "mac": {
      "icon": "PrintMO_Orders.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "PrintMO_Orders.ico",
      "target": ["nsis", "zip"]
    }
  }
}
